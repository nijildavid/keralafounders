# Block PHP's own error log (and any rotated copies) from being fetched directly —
# it can contain internal file paths and stack traces.
<IfModule mod_authz_core.c>
    <FilesMatch "^error_log">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^error_log">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Don't let visitors browse raw directory listings (e.g. /assets/, /api/).
Options -Indexes

# Baseline security headers.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Stops PHP from advertising its exact version to every visitor — free
    # recon for an attacker looking for a known vulnerability to try.
    Header always unset X-Powered-By
    # Locks down where the browser is allowed to load/execute code from.
    # script-src is deliberately the tight part (blocks a malicious <script
    # src="attacker.com/x.js"> even if it gets injected somewhere); the rest
    # stays permissive (https: for images/fonts/connections) because the site
    # has no build step to switch every inline <script>/onclick handler and
    # the consent/analytics tools (CookieHub, Google Analytics) call several
    # subdomains that aren't practical to enumerate one by one.
    # style-src must include cdn.cookiehub.eu: CookieHub only shows its banner
    # after its own stylesheet (cdn.cookiehub.eu/c2/css/...) finishes loading,
    # so blocking it hides the banner and leaves analytics consent denied.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.cookiehub.eu; style-src 'self' 'unsafe-inline' https://cdn.cookiehub.eu; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src https://open.spotify.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# Let browsers cache static assets instead of re-downloading them on every
# visit. Deliberately excludes .php files (assets/data.php, sitemap.php) —
# those generate their response from the database and must not be cached.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# data.php declares itself as application/javascript (so the client-side
# filtering JS can load it via <script src>), which makes the
# ExpiresByType application/javascript rule above match it too — by
# content-type, not file extension, so the "excludes .php files" comment
# above doesn't actually cover it. Without this override a stale company
# edit/approval could take up to a month to show up for visitors.
<IfModule mod_headers.c>
    <Files "data.php">
        Header always set Cache-Control "no-store"
        Header unset Expires
    </Files>
</IfModule>

ErrorDocument 404 /404.php

RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Canonicalize the homepage to / — index.php still serves it (DirectoryIndex),
# this only fires when the URL itself literally says /index.php.
RewriteRule ^index\.php$ / [R=301,L]

# Old static pages moved to server-rendered PHP equivalents (query strings pass through automatically).
RewriteRule ^index\.html$ index.php [R=301,L]
RewriteRule ^founders\.html$ founders.php [R=301,L]
RewriteRule ^countries\.html$ countries.php [R=301,L]
RewriteRule ^company\.html$ company.php [R=301,L]
RewriteRule ^about\.html$ about.php [R=301,L]
RewriteRule ^add-company\.html$ add-company.php [R=301,L]
RewriteRule ^privacy\.html$ privacy.php [R=301,L]
